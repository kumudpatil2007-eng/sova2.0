# SOVA Environment Configuration (Air-Gapped Industrial Workbench)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model Routing Configuration
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=deepseek-r1:7b
OLLAMA_DOCUMENT_MODEL=llama3.2:3b
OLLAMA_GENERAL_MODEL=gemma2:9b

# Active Default Model
OLLAMA_MODEL=llama3.2:3b

# Model Keep-Alive (Optimized for RTX 4050 6GB VRAM - allows lazy loading/switching)
OLLAMA_KEEP_ALIVE=10m

# Generation Parameters
TEMPERATURE=0.2
MAX_TOKENS=1024
CONTEXT_LENGTH=4096

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

# Security & Development Flags (Never use mock fallback in production)
DEV_MOCK_FALLBACK=False
